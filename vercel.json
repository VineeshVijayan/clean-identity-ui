{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://identity-hub.ndashdigital.com/api/$1"
    },
    {
      "source": "/session-api/(.*)",
      "destination": "https://identity-hub.ndashdigital.com/api/$1"
    },
    {
      "source": "/identity-api/(.*)",
      "destination": "https://identity-hub.ndashdigital.com/api/$1"
    },
    {
      "source": "/connector-api/(.*)",
      "destination": "https://identity-hub.ndashdigital.com/api/$1"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
